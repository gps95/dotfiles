    //    "format-icons": ["", "", "", "", ""]
    //},
    //"battery#bat2": {
    //    "bat": "BAT2"
    //},
    //"power-profiles-daemon": {
    //  "format": "{icon}",
    //  "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    //  "tooltip": true,
    //  "format-icons": {
    //    "default": "",
    //    "performance": "",
    //    "balanced": "",
    //    "power-saver": ""
    //  }
    //},
    "network": {
      "format": "",
      "format-wifi": "",
      "format-ethernet": "󰊗",
      "format-disconnected": "",
      "tooltip-format": "{ifname} via {gwaddr}  󰊗",
      "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
      "tooltip-format-ethernet": "{ifname} 󰊗",
      "tooltip-format-disconnected": "",
      "max-length": 50,
      "on-click": "exec kitty impala"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "󰅶",
        "format-icons": {
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "group/volume": {
      "orientation": "horizontal",
      "modules": [
        "pulseaudio",
        "pulseaudio/slider"
      ]
    },
    "bluetooth": {
      "format": "",
      "format-disabled": "", // empty format hides the module
      "format-connected": " {num_connections}",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "on-click": "exec kitty --title bluetui bluetui"
    },
    "custom/battery": {
        "exec-if": "ls -d /sys/class/power_supply/BAT* >/dev/null 2>&1",
        "exec": "~/.config/waybar/scripts/battery.sh",
        "return-type": "json",
        "interval": 60
    }

