    },
    "clock": {
        // "timezone": "America/New_York",
	"format": "{:%H:%M %d/%m/%Y}",
        //"format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
	"calendar":{
	  "mode": "year",
	  "mode-mon-col": 4,
	  "weeks-pos": "right",
	  "on-scroll": 1,
	  "format":{
            "today": "<span color='#00ff00'><b><u>{}</u></b></span>",
            "weekdays": "<span color='#ffcc66'><b><u>{}</u></b></span>",
            "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
            "months": "<span color='#ffead3'><b>{}</b></span>"
	  }
	  //"actions":{
          //  "on-click-right": "mode",
	  //  "on-scroll-up": "shift_up",
	  //  "on-scroll-down": "shift_down"
	  //}
	}
    },
    "cpu": {
      "format": "{usage}% ",
      "interval": 10,
      "on-click": "exec kitty btop"
    },
    "memory": {
      "format": "{}% ",
      "tooltip-format": "{used} GB / {total} GB",
      "interval": 30,
      "on-click": "exec kitty htop"
    },
    "custom/temps":{
       "exec": "~/.config/waybar/scripts/temps.sh",
       "return-type": "json",
       "interval": 10
    },
    //"temperature": {
