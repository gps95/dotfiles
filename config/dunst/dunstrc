[global]
  monitor = 1
  #mouse: follow mouse pointer
  #keyboard: follow window with keyboard focus
  #none: don't follow anything
  #all of these override the monitor option 
  follow = mouse

[pi]
  appname = pi
  script = ~/.config/dunst/scripts/pi-sound.sh

[pi-question]
  appname = pi
  category = pi-question
