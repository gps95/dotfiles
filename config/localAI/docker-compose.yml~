services:
  # ---- Chat UI, talks to llama-server via OpenAI-compatible API ----
  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: open-webui
    restart: unless-stopped
    ports:
      - "3000:8080"
    volumes:
      - ./data/open-webui:/app/backend/data
    environment:
      OPENAI_API_BASE_URL: "http://llama-server:8080/v1"
      OPENAI_API_KEY: "sk-local"        # llama.cpp ignores the key, but the field is required
      WEBUI_AUTH: "true"
    depends_on:
      - llama-server

  # ---- Image / video generation (Krea 2, Wan, etc.) ----
  comfyui:
    image: yanwk/comfyui-boot:${COMFYUI_IMAGE_TAG}
    container_name: comfyui
    restart: unless-stopped
    stdin_open: true
    tty: true
    ports:
      - "8188:8188"
    volumes:
      - ./data/comfyui:/root
    environment:
      HSA_OVERRIDE_GFX_VERSION: "${HSA_OVERRIDE_GFX_VERSION}"
      CLI_ARGS: ""
    devices:
      - /dev/kfd
      - /dev/dri
    group_add:
      - video
      - render
    cap_add:
      - SYS_PTRACE
    security_opt:
      - seccomp=unconfined
    ipc: host

  # ---- LLM inference (text) ----
  llama-server:
    image: ghcr.io/ggml-org/llama.cpp:server-rocm
    container_name: llama-server
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - ./models/llm:/models
    environment:
      HSA_OVERRIDE_GFX_VERSION: "${HSA_OVERRIDE_GFX_VERSION}"
    command: >
      --model /models/${LLM_MODEL_FILE}
      --ctx-size ${LLM_CTX_SIZE}
      --parallel ${LLM_N_PARALLEL}
      --n-gpu-layers ${LLM_N_GPU_LAYERS}
      --host 0.0.0.0
      --port 8080
      ${ADDITIONAL_COMMANDPARAMS}
    devices:
      - /dev/kfd
      - /dev/dri
    group_add:
      - video
      - render
    security_opt:
      - seccomp=unconfined
    ipc: host

networks:
  default:
    name: localainetwork
