# Your GPU's gfx target, check with: rocminfo | grep gfx
HSA_OVERRIDE_GFX_VERSION=11.0.1

#GID of the 'video' group on your host - find it with: getent group video
VIDEO_GID:984

#GID of the 'render' group on your host - find it with: getent group render
RENDER_GID:988

#Model name
LLM_MODEL_FILE=GLM-4.7-Flash-Q4_K_M.gguf
#Basic Model params
LLM_CTX_SIZE=8192
LLM_N_PARALLEL=1
LLM_N_GPU_LAYERS=999
#Extra Model params, space separated, added as-is to the command
ADDITIONAL_COMMANDPARAMS=--n-cpu-moe 25

# Which ComfyUI ROCm image to use (rocm or rocm7)
COMFYUI_IMAGE_TAG=rocm